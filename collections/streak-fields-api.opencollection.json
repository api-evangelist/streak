{
  "opencollection": "1.0.0",
  "info": {
    "name": "Streak REST Boxes Fields API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Fields",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all custom fields defined on a pipeline",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.streak.com/api/v1/pipelines/:pipelineKey/fields",
            "params": [
              {
                "name": "pipelineKey",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List all custom fields defined on a pipeline"
        },
        {
          "info": {
            "name": "Create a new custom field on a pipeline",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.streak.com/api/v1/pipelines/:pipelineKey/fields",
            "params": [
              {
                "name": "pipelineKey",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Create a new custom field on a pipeline"
        }
      ]
    }
  ],
  "bundled": true
}