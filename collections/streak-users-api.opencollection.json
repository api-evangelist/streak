{
  "opencollection": "1.0.0",
  "info": {
    "name": "Streak REST Boxes Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the currently authenticated user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.streak.com/api/v1/users/me"
          },
          "docs": "Get the currently authenticated user"
        }
      ]
    }
  ],
  "bundled": true
}